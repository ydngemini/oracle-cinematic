{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PasswordlessAuroraConnect",
      "Effect": "Allow",
      "Action": [
        "rds-db:connect"
      ],
      "Resource": [
        "arn:aws:rds-db:us-east-2:ACCOUNT_ID:dbuser:DB_RESOURCE_ID/oracle_app_login"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "true"
        }
      }
    }
  ]
}

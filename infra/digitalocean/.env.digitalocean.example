# DigitalOcean production environment template.
#
# This is a FOCUSED subset of .env.prod.example — only the vars a
# DigitalOcean deploy actually sets, cloud-agnostic ones included by
# reference. See docs/deploy-digitalocean.md for what each one is and where
# it comes from. Copy to .env.digitalocean and fill in real values; never
# commit it. infra/digitalocean/app.yaml is the source of truth for what
# App Platform actually deploys — this file is for local testing against a
# real DO database/Spaces bucket, or as a reference when filling in
# App Platform's secret fields by hand.

ORACLE_ENV=prod
ORACLE_PROCESS_ROLE=all          # api/worker split only matters on App Platform itself
ORACLE_PUBLIC_BASE_URL=https://neohrs.com

# ── Database: DigitalOcean Managed PostgreSQL ─────────────────────────────────
# No ORACLE_DB_AUTH — that selects Azure Entra / AWS IAM token auth, neither of
# which DO uses. Leave unset for the generic password+TLS path.
ORACLE_DB_HOST=
ORACLE_DB_PORT=25060
ORACLE_DB_NAME=oracle
ORACLE_DB_USER=oracle_app_login
ORACLE_DB_PASSWORD=
ORACLE_DB_SSLMODE=require
# Only if you need verify-full against DO's own CA rather than the system
# trust store (which already works — see docs/deploy-digitalocean.md §Database):
# ORACLE_DB_CA_BUNDLE=/path/to/do-ca-certificate.crt

# Migration runner admin credentials (separate role — needs DDL privileges).
ORACLE_DB_ADMIN_USER=doadmin
ORACLE_DB_ADMIN_PASSWORD=

# ── Redis: DigitalOcean Managed Valkey ────────────────────────────────────────
REDIS_URL=rediss://default:<password>@<host>:25061
ORACLE_REQUIRE_REDIS=0           # 1 to make a Redis outage a boot-time failure

# ── Object storage: DigitalOcean Spaces ───────────────────────────────────────
ORACLE_STORAGE_BACKEND=s3
ORACLE_S3_BUCKET=neoh-media
ORACLE_S3_REGION=nyc3
ORACLE_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
ORACLE_S3_ACCESS_KEY_ID=
ORACLE_S3_SECRET_ACCESS_KEY=

# Contract vault — same Spaces bucket family, separate bucket recommended.
CONTRACT_VAULT_BUCKET=neoh-secure-contracts
CONTRACT_VAULT_MAX_BYTES=10485760

# ── Secrets (see docs/deploy-digitalocean.md §Secrets for sourcing) ───────────
ORACLE_SECRET_KEY=
ORACLE_ENCRYPTION_MASTER_KEY=
ORACLE_ADMIN_ID=
ORACLE_ADMIN_PASSPHRASE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ORACLE_BRIDGE_ACCESS_TOKEN=
ORACLE_SMTP_HOST=
ORACLE_SMTP_PORT=587
ORACLE_SMTP_USERNAME=
ORACLE_SMTP_PASSWORD=
ORACLE_SMTP_FROM_EMAIL=

# ── AI chat provider ───────────────────────────────────────────────────────────
# Any of bedrock|azure-foundry|fireworks|local remain valid; fireworks has no
# cloud-provider dependency and is the deploy-agnostic default recommendation.
ORACLE_AI_CHAT_PROVIDER=fireworks
ORACLE_FIREWORKS_API_KEY=

# ── Background work (worker role / ORACLE_PROCESS_ROLE=all only) ─────────────
ORACLE_SCHEDULER_ENABLED=1
ORACLE_MISSIONS_ENABLED=0        # see the Neoh AI agent vault note before flipping this
ORACLE_FEATURE_MISSIONS=0

# ── Release identity (baked by CI, not set by hand — see GET /version) ───────
# ORACLE_GIT_SHA=
# ORACLE_APP_VERSION=
# ORACLE_BUILD_TIMESTAMP=

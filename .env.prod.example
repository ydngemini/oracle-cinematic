# ──────────────────────────────────────────────────────────────────────────
# Neoh production environment template.  COPY to a real secret store — DO NOT
# commit a filled-in copy (the real .env / .env.prod are gitignored).
#
# In the Azure deployment, secrets are injected through Container Apps / Key
# Vault references; the non-secret toggles are plain Container Apps environment
# values. config.validate_or_die() HARD-FAILS the boot in prod if either of the
# two ★REQUIRED★ secrets is missing.
# ──────────────────────────────────────────────────────────────────────────

# ── core ──────────────────────────────────────────────────────────────────
ORACLE_ENV=prod                          # anything not in {dev,development,local,test} = prod gate ON
ORACLE_SECRET_KEY=                        # ★REQUIRED★ JWT signing — 64+ random hex (openssl rand -hex 48)
ORACLE_ENCRYPTION_MASTER_KEY=             # ★REQUIRED★ pgcrypto PII key — 64+ random hex; ROTATING loses data
ORACLE_CORS_ORIGINS=https://app.neoh.example      # comma-separated exact origins; NO wildcard in prod
ORACLE_BASE_URL=https://app.neoh.example          # public base URL (used in links/redirects)
ORACLE_DEMO_TENANT_ID=00000000-0000-0000-0000-000000000000   # tenant real leads live under (see memory)
ORACLE_ENABLE_DEMO_LOGINS=0               # MUST be 0 in prod — never ship the hardcoded demo creds
ORACLE_JWT_ISSUER=https://neohrs.com        # required in prod; tokens must carry matching iss
ORACLE_JWT_AUDIENCE=neoh-web               # required in prod; tokens must carry matching aud
ORACLE_ADMIN_ID=                           # operator account id (real platform-admin login)
ORACLE_ADMIN_PASSPHRASE=                   # operator account passphrase (store as secret)
ORACLE_PUBLIC_BASE_URL=https://api.neoh.example     # provider webhook/OAuth callback origin

# ── approved command providers ────────────────────────────────────────────
ORACLE_SES_FROM_EMAIL=                     # SES-verified sender address
GOOGLE_CLIENT_ID=                          # OAuth web client id (Secrets Manager in ECS)
GOOGLE_CLIENT_SECRET=                      # OAuth web client secret (Secrets Manager in ECS)
GOOGLE_OAUTH_REDIRECT_URI=https://api.neoh.example/api/commands/providers/google/oauth/callback
TWILIO_ACCOUNT_SID=                        # optional global fallback; prefer tenant credential vault
TWILIO_AUTH_TOKEN=                         # secret
TWILIO_API_KEY=                           # optional SK... API key SID (for API-key auth)
TWILIO_API_SECRET=                        # optional matching API key secret
TWILIO_FROM_NUMBER=
ORACLE_TWILIO_TWIML_URL=                   # HTTPS TwiML app/flow URL
ORACLE_TWILIO_STATUS_CALLBACK=https://api.neoh.example/api/commands/webhooks/twilio

# Custom internet call provider fallback (your own SIP/VoIP gateway API).
# Expects JSON POST for outbound and callbacks to /api/commands/webhooks/custom-call.
ORACLE_CUSTOM_CALL_API_URL=
ORACLE_CUSTOM_CALL_AUTH_TOKEN=
ORACLE_CUSTOM_CALL_FROM_NUMBER=

# ── Azure Communication Services (inbound + outbound phone calls) ──────────
# In Azure: inject ACS_CONNECTION_STRING as a Container Apps secret reference
# referencing neoh-kv-120ea104 → acs-connection-string. ACS_FROM_NUMBER can
# be a plain env var (E.164 format). ORACLE_PUBLIC_BASE_URL must be the HTTPS
# origin that ACS webhooks (Event Grid) can reach.
ACS_CONNECTION_STRING=                     # secret — Container Apps secret ref or Key Vault
ACS_FROM_NUMBER=                           # +1XXXXXXXXXX (E.164) — the ACS-purchased phone number
ORACLE_PUBLIC_BASE_URL=https://api.neoh.example     # required for ACS callback webhooks

# ── database (Aurora PostgreSQL, IAM auth — NO static password for the app) ──
ORACLE_DB_HOST=                            # Aurora writer endpoint (terraform output db_writer_endpoint)
ORACLE_DB_PORT=5432
ORACLE_DB_NAME=oracle
ORACLE_DB_USER=oracle_app_login            # IAM-auth login role created by migration 0003
ORACLE_DB_PASSWORD=                         # LEAVE BLANK under IAM auth — connection.py mints an rds-db:connect token
ORACLE_DB_SSLMODE=verify-full              # TLS required (rds.force_ssl=1); verify against the RDS CA
ORACLE_RDS_CA_BUNDLE=/etc/ssl/certs/rds-global-bundle.pem   # baked into the image or mounted
ORACLE_DB_POOL_MIN=2
ORACLE_DB_POOL_MAX=10

# ── Stripe (LIVE keys bill real cards — use a restricted key; test in staging) ──
STRIPE_SECRET_KEY=                         # sk_live_… (secret) — keep in Secrets Manager only
STRIPE_WEBHOOK_SECRET=                     # whsec_… for the live webhook endpoint
STRIPE_PRICE_ID=                           # price_… of the subscription plan
STRIPE_AUTOMATIC_TAX=0
STRIPE_REQUIRE_TOS=1

# ── AWS / Bedrock (region only; auth is the task role, no keys) ──────────────
AWS_REGION=us-east-1
BEDROCK_REGION=us-east-1

# ── data provider keys (optional; features degrade honestly when absent) ─────
RENTCAST_API_KEY=                          # optional AVM only; never used as an MLS/listing source
ATTOM_API_KEY=
FRED_API_KEY=
WALKSCORE_API_KEY=
CENSUS_API_KEY=
BLS_API_KEY=
DATA_GOV_API_KEY=
# Regrid nationwide parcel/property facts. Store a restricted token in Secrets
# Manager; it is used only by the server-side parcel lookup connector.
REGRID_API_TOKEN=
# Official GovInfo MCP (https://api.govinfo.gov/mcp). Use a dedicated
# api.data.gov key in Secrets Manager; it is used only by the backend proxy.
GOVINFO_API_KEY=
COURTLISTENER_TOKEN=

# Licensed MLS feeds. Keep this JSON in Key Vault and reference it from the
# Container App; never commit bearer tokens. Each feed has an independent DB
# cursor and failures are isolated. token_env may name another secret-backed
# environment variable, or a Key Vault secret may contain the complete JSON.
ORACLE_RESO_FEEDS_JSON=
# Example shape (documentation only):
# [{"id":"bright","name":"Bright MLS","url":"https://provider.example/RESO/OData/Property","token_env":"ORACLE_RESO_TOKEN_BRIGHT"}]
# Mandatory in production. Exact hosts only; this operator-reviewed allowlist
# prevents a listing aggregator or consumer portal from being substituted for a
# direct licensed MLS endpoint.
ORACLE_RESO_ALLOWED_HOSTS=
ORACLE_RESO_CONCURRENCY=3
ORACLE_RESO_MAX_PAGES=200

# Public aggregate market research. This does not scrape consumer listing pages
# and must not be represented as an active-listing feed.
ORACLE_MARKET_RESEARCH_ENABLED=1
ORACLE_MARKET_RESEARCH_INTERVAL_HOURS=24
ORACLE_MARKET_DATA_CONCURRENCY=2
ORACLE_MARKET_DATA_MAX_BYTES=75000000
ORACLE_MARKET_DATA_UPSERT_BATCH_SIZE=100
ORACLE_MARKET_AI_SUPERVISOR_ENABLED=0
ORACLE_MARKET_AI_SUPERVISOR_MODEL=gpt-oss-120b
ORACLE_MARKET_AI_SUPERVISOR_TIMEOUT_SECONDS=20
ORACLE_ZILLOW_ZHVI_CSV_URL=
ORACLE_ZILLOW_INVENTORY_CSV_URL=
ORACLE_REDFIN_MARKET_CSV_URL=
ORACLE_FHFA_HPI_CSV_URL=
ORACLE_HUD_FMR_CSV_URL=

# ── national public-property pipeline (Azure production) ────────────────────
# The Firehose has a real public-data adapter for every US state (plus DC).
# Some sources are county/city anchors; the lead provenance exposes that scope.
# Keep the bounded cap and 24h cadence: never run an unbounded national scrape.
ORACLE_SCHEDULER_ENABLED=1
ORACLE_INGEST_TENANT_ID=00000000-0000-0000-0000-000000000000  # platform ingest tenant
ORACLE_FEATURE_MUNICIPAL_HARVESTS=true
ORACLE_PARCEL_HARVEST_ENABLED=1
ORACLE_HARVEST_INTERVAL_HOURS=24
ORACLE_HARVEST_MAX_PER_STATE=100
# Azure Container Apps worker: one rate-limited sample per jurisdiction keeps
# source health honest between full harvests. It does not bypass portal limits.
ORACLE_SOURCE_HEALTH_PROBES_ENABLED=1
ORACLE_SOURCE_HEALTH_PROBE_INTERVAL_HOURS=24
# Separate catalog-only replay for bedrooms, baths, rooms, year, sale and area
# fields newly exposed by assessor/CAMA sources. Uses its own cursor namespace.
ORACLE_PROPERTY_FACT_BACKFILL_ENABLED=1
ORACLE_PROPERTY_FACT_BACKFILL_INTERVAL_HOURS=6
ORACLE_PROPERTY_FACT_BACKFILL_MAX_PER_STATE=1000
ORACLE_PROPERTY_FACT_BACKFILL_CONCURRENCY=2
ORACLE_JOB_LEASE_SECONDS=900
# Database-only legacy cleanup: validates public-record fields and adds source
# provenance. It never scrapes, predicts, or fills missing property facts.
ORACLE_LEAD_NORMALIZE_BATCH_SIZE=500
ORACLE_LEAD_NORMALIZE_MAX_ROWS=10000

# ── remaining ops toggles ──────────────────────────────────────────────────
COUNTY_HARVEST_ENABLED=0
SPATIAL_ALLOW_WEB_SCRAPE=0
SCOUT_USE_MOCK=0
ORACLE_WS_IDLE_TIMEOUT=300

# ── frontend build-time (browser-PUBLIC; baked into the JS bundle, not secret) ──
# Passed as Docker build args to oracle-app/Dockerfile, NOT task env.
# Azure Container Apps uses split web/API hosts; do not leave these blank unless
# the selected ingress genuinely proxies /api and /ws to the backend.
VITE_API_BASE=https://neoh-api.livelypebble-f08762d5.northcentralus.azurecontainerapps.io
VITE_WS_URL=wss://neoh-api.livelypebble-f08762d5.northcentralus.azurecontainerapps.io
VITE_GOOGLE_MAPS_KEY=                       # restrict by HTTP referrer in the Google Cloud console
VITE_GOOGLE_MAP_ID=                         # optional production map ID for Advanced Markers

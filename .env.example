# Oracle — environment variable template
# Copy to .env and fill in real values. Never commit .env.
#
# Local dev defaults (marked with "local default") work against the postgres:16
# container that docker-compose spins up. Production values differ — see comments.

# ── Database ──────────────────────────────────────────────────────────────────
# Host of the PostgreSQL / Aurora cluster.
# local default: "db" (the docker-compose service name resolves inside the stack)
# Aurora prod: the cluster endpoint, e.g. oracle.cluster-xyz.us-east-2.rds.amazonaws.com
ORACLE_DB_HOST=db

# Postgres port (almost always 5432).
ORACLE_DB_PORT=5432

# Database name — must match POSTGRES_DB in the db service.
ORACLE_DB_NAME=oracle

# Runtime login role. Local dev uses the postgres superuser so the app can also
# run migrations. On Aurora, use a least-privilege IAM role (oracle_app_login).
ORACLE_DB_USER=postgres

# Plain-text password for local dev password-auth path (db/connection.py detects
# this and skips the IAM token + TLS 1.3 path). Leave blank on Aurora prod —
# the IAM auth token replaces it.
ORACLE_DB_PASSWORD=postgres

# SSL mode. "disable" is safe inside the compose network (loopback only).
# Aurora prod: leave unset (defaults to TLS 1.3 + cert verification).
ORACLE_DB_SSLMODE=disable

# Admin user for ignite_memory.py (needs CREATE TABLE / INSERT).
# Same as ORACLE_DB_USER in local dev; the app runtime role on Aurora prod.
ORACLE_DB_ADMIN_USER=postgres

# Convenience alias accepted by ignite_memory.py — overrides all ORACLE_DB_* above.
# Leave blank to use the individual vars.
# DATABASE_URL=postgresql://postgres:postgres@db:5432/oracle

# ── AWS (only required for Aurora IAM auth on prod) ───────────────────────────
# When ORACLE_DB_PASSWORD is blank, db/connection.py calls boto3 to mint a
# 15-minute RDS IAM token. These creds need rds:GenerateDbAuthToken permission.
# Never set these in local dev — the docker-compose postgres container doesn't
# use them and the blank-password check skips boto3 entirely.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Path to the Amazon RDS global CA bundle (Aurora prod TLS verification).
# Download from https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
ORACLE_RDS_CA_BUNDLE=/etc/ssl/certs/rds-global-bundle.pem

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign JWTs. Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
# MUST be changed before any real users authenticate — the default in auth.py is
# a hardcoded placeholder.
ORACLE_SECRET_KEY=CHANGE_ME_generate_64_byte_hex_secret_before_any_real_auth

# ── Stripe ───────────────────────────────────────────────────────────────────
# Test-mode keys from https://dashboard.stripe.com/test/apikeys
# Webhook secret from the Stripe CLI: stripe listen --print-secret
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_ID=price_REPLACE_ME

# ── Frontend / CORS ──────────────────────────────────────────────────────────
# Base URL the backend uses for Stripe success/cancel redirects.
ORACLE_BASE_URL=http://localhost:5173

# WebSocket URL the Vite dev server injects into the React bundle.
VITE_WS_URL=ws://localhost:8000/ws

# ── Tenant config (demo / local dev) ─────────────────────────────────────────
# The tenant_id the harvesters ingest under and the WS endpoint falls back to
# when no JWT tenant is present. Must be a valid UUID in prod (RLS enforces it).
ORACLE_DEMO_TENANT_ID=11111111-1111-1111-1111-111111111111

# ── Local LLM (Agent Mind / Memory Core summarizer) ──────────────────────────
# llama-server running Llama-3.2-1B-Instruct. Not required to boot the server —
# mind_service.py and session_manager.py degrade gracefully when unreachable.
ORACLE_LOCAL_LLM_URL=http://127.0.0.1:8090/v1/chat/completions

# ── Kubernetes (Admin C2 chaos panel — optional) ──────────────────────────────
# Only needed if you use /admin/simulate-surge in a real cluster.
# Leave blank for local dev — the K8s HPA queries fail silently with a
# "no_k8s_credentials" placeholder rather than crashing the surge endpoint.
K8S_API_HOST=https://kubernetes.default.svc
K8S_BEARER_TOKEN=
QWEN_VOICE_DEPLOYMENT=qwen-voice-agent
QWEN_VOICE_NAMESPACE=oracle
QWEN_VOICE_HPA=qwen-voice-agent-hpa

# ── Harvester tuning (optional overrides) ────────────────────────────────────
# Sensible defaults are baked into harvesters/base.py; set these only if you
# need to throttle or speed up the 10-state firehose.
# FIREHOSE_MIN_INTERVAL=1.5
# FIREHOSE_JITTER=0.8
# FIREHOSE_MAX_RETRIES=5
# FIREHOSE_PAGE_SIZE=1000
# FIREHOSE_BATCH_SIZE=500

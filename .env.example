# Oracle — environment variable template
# Copy to .env and fill in real values. Never commit .env.
#
# Local dev defaults (marked with "local default") work against the postgres:16
# container that docker-compose spins up. Production values differ — see comments.

# ── Database ──────────────────────────────────────────────────────────────────
# Host of the PostgreSQL server.
# local default: "db" (the docker-compose service name resolves inside the stack)
# Azure prod: neoh-db-120ea104.postgres.database.azure.com (private access only)
ORACLE_DB_HOST=db

# Postgres port (almost always 5432).
ORACLE_DB_PORT=5432

# Database name — must match POSTGRES_DB in the db service.
ORACLE_DB_NAME=oracle

# Runtime login role. Local dev uses the postgres superuser so the app can also
# run migrations. In prod use the non-owner oracle_app_login so FORCE RLS applies.
ORACLE_DB_USER=postgres

# Plain-text password for the local dev password-auth path (db/connection.py
# detects this and skips token auth + TLS entirely). Leave blank in prod — a
# short-lived cloud token replaces it.
ORACLE_DB_PASSWORD=postgres

# SSL mode. "disable" is safe inside the compose network (loopback only).
# Prod: leave unset (defaults to verified TLS).
ORACLE_DB_SSLMODE=disable

# Which passwordless mechanism to use when ORACLE_DB_PASSWORD is blank.
#   azure-entra (default) — Entra token for Azure Postgres Flexible Server
#   aws-iam               — legacy RDS/Aurora IAM token
# Ignored entirely in local dev, where the password above wins.
# ORACLE_DB_AUTH=azure-entra

# Minimum TLS version for the DB connection: 1.2 (default on Azure, which may
# negotiate either) or 1.3 (default on aws-iam). Only set to override.
# ORACLE_DB_TLS_MIN=1.2

# CA bundle for the DB server certificate. Leave unset on Azure — the system
# trust store already verifies its publicly-rooted cert. Only RDS needs a pin.
# ORACLE_DB_CA_BUNDLE=

# Admin user for ignite_memory.py (needs CREATE TABLE / INSERT).
# Same as ORACLE_DB_USER in local dev; the administrator login in prod.
ORACLE_DB_ADMIN_USER=postgres

# Convenience alias accepted by ignite_memory.py — overrides all ORACLE_DB_* above.
# Leave blank to use the individual vars.
# DATABASE_URL=postgresql://postgres:postgres@db:5432/oracle

# ── Azure identity ────────────────────────────────────────────────────────────
# Selects the user-assigned managed identity (neoh-app-id) for DB tokens, Key
# Vault and Blob. Unset locally, where DefaultAzureCredential falls back to the
# Azure CLI login.
# AZURE_CLIENT_ID=

# Key Vault holding the migration administrator credential. run_migrations.py
# reads ORACLE_DB_ADMIN_SECRET from here when ORACLE_DB_ADMIN_PASSWORD is unset.
# ORACLE_KEY_VAULT_URI=https://neoh-kv-120ea104.vault.azure.net/
# ORACLE_DB_ADMIN_SECRET=oracle-db-admin-password

# ── Object storage ────────────────────────────────────────────────────────────
# Where durable files (contract PDFs, uploaded video, splats) are written.
#   azure-files (default) — the shared /mnt/neoh mount; every replica sees it
#   azure-blob            — Blob Storage; the only backend that can mint
#                           expiring links, so the contract vault needs it
#   s3                    — legacy AWS
ORACLE_STORAGE_BACKEND=azure-files
ORACLE_MEDIA_ROOT=/mnt/neoh

# azure-blob only. Prefer the account URL + managed identity; the connection
# string is only needed where no identity is available.
# ORACLE_BLOB_ACCOUNT_URL=https://neohfiles120ea104.blob.core.windows.net
# ORACLE_BLOB_CONTAINER=neoh-media
# AZURE_STORAGE_CONNECTION_STRING=

# Container/bucket for generated legal PDFs, capped at one-hour expiring links.
CONTRACT_VAULT_BUCKET=neoh-secure-contracts
CONTRACT_VAULT_MAX_BYTES=10485760

# ── AWS (legacy — only for ORACLE_DB_AUTH=aws-iam, EMAIL_PROVIDER=ses, or S3) ──
# Every AWS import is lazy, so an Azure-only deployment never loads boto3 and
# these can all stay blank.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Regrid nationwide parcel/property facts. Keep this server-side only; never
# expose it in browser code or commit a real value. Also supplies address-matched
# BUILDING FOOTPRINTS to /api/crm/floorplan/footprint-candidates.
REGRID_API_TOKEN=

# OpenStreetMap Overpass endpoint — the free, openly-licensed (ODbL) source of
# building outlines when Regrid has no match. Override to use a mirror or a
# self-hosted instance; the public endpoint rate-limits under load.
# ORACLE_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional licensed MLS / RESO Web API. A single local feed can use these
# variables; production can combine boards with secret-backed
# ORACLE_RESO_FEEDS_JSON (see .env.prod.example). Never scrape member portals.
ORACLE_RESO_URL=
ORACLE_RESO_TOKEN=
ORACLE_RESO_MLS_ID=
ORACLE_RESO_MLS_NAME=
ORACLE_RESO_PAGE=500
ORACLE_RESO_MAX_PAGES=200
# Required outside dev/test: exact direct MLS endpoint hosts, comma-separated.
ORACLE_RESO_ALLOWED_HOSTS=

# Redistributable aggregate housing research (not individual listings).
# Uses publisher-provided downloads from Zillow Research, Redfin Data Center,
# FHFA, and HUD; URLs are optional overrides for publisher path rotations.
ORACLE_MARKET_RESEARCH_ENABLED=1
ORACLE_MARKET_RESEARCH_INTERVAL_HOURS=24
ORACLE_MARKET_DATA_CONCURRENCY=2
ORACLE_MARKET_DATA_MAX_BYTES=75000000
ORACLE_MARKET_DATA_UPSERT_BATCH_SIZE=100
ORACLE_MARKET_AI_SUPERVISOR_ENABLED=0
ORACLE_MARKET_AI_SUPERVISOR_MODEL=gpt-oss-120b
ORACLE_MARKET_AI_SUPERVISOR_TIMEOUT_SECONDS=20
ORACLE_ZILLOW_ZHVI_CSV_URL=
ORACLE_ZILLOW_INVENTORY_CSV_URL=
ORACLE_REDFIN_MARKET_CSV_URL=
ORACLE_FHFA_HPI_CSV_URL=
ORACLE_HUD_FMR_CSV_URL=

# Official U.S. Government Publishing Office GovInfo MCP. Sign up for a free
# api.data.gov key, then set this server-side value to enable federal-source
# research in Contracts. It is never sent to the browser.
# GOVINFO_API_KEY=

# Approved command providers. Twilio can instead be configured per tenant
# through /api/commands/providers/twilio. Google below is CALENDAR-ONLY —
# Authorization Code + PKCE, per-agent tokens encrypted in PostgreSQL. Mail never
# goes through it; see ORACLE_EMAIL_PROVIDER.
ORACLE_PUBLIC_BASE_URL=http://localhost:8000

# Transactional email. Selects the sender used for password reset and for
# approved outbound mail. "smtp" (default) | "acs" | "ses".
# ORACLE_EMAIL_PROVIDER=smtp

# Platform SMTP — the mail server YOU run or choose. There is deliberately no
# default host: guessing one would silently route mail through a third party.
# Port 465 is implicit TLS; anything else must offer STARTTLS or the send is
# abandoned rather than downgraded.
# Tenants can override all of these per-tenant via the `smtp` provider vault.
# See docs/email-dns-setup.md for the DNS records this sender needs.
ORACLE_SMTP_HOST=
ORACLE_SMTP_PORT=587
ORACLE_SMTP_USERNAME=
ORACLE_SMTP_PASSWORD=
ORACLE_SMTP_FROM_EMAIL=
ORACLE_SMTP_FROM_NAME=Neoh

# Alternative senders, only read when ORACLE_EMAIL_PROVIDER selects them.
ORACLE_ACS_FROM_EMAIL=
ORACLE_SES_FROM_EMAIL=

# Calendar only (see the note above the provider block).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/commands/providers/google/oauth/callback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM_NUMBER=
ORACLE_TWILIO_TWIML_URL=
ORACLE_TWILIO_STATUS_CALLBACK=http://localhost:8000/api/commands/webhooks/twilio

# Custom internet call provider fallback (your own SIP/VoIP gateway API).
# The provider must accept JSON POST {to, from, callback_url, provider, channel, draft}
# and call back /api/commands/webhooks/custom-call with optional speech events.
ORACLE_CUSTOM_CALL_API_URL=
ORACLE_CUSTOM_CALL_AUTH_TOKEN=
ORACLE_CUSTOM_CALL_FROM_NUMBER=

# ── Azure Communication Services (phone calls) ─────────────────────────────────
# Required for inbound and outbound voice calls. Get these from:
#   Azure Portal → Communication Services → neoh-comm → Keys
# The phone number must be purchased in ACS under "Phone Numbers."
ACS_CONNECTION_STRING=
ACS_FROM_NUMBER=

# Path to the Amazon RDS global CA bundle (Aurora prod TLS verification).
# Download from https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
ORACLE_RDS_CA_BUNDLE=/etc/ssl/certs/rds-global-bundle.pem

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign JWTs. Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
# MUST be changed before any real users authenticate — the default in auth.py is
# a hardcoded placeholder.
ORACLE_SECRET_KEY=CHANGE_ME_generate_64_byte_hex_secret_before_any_real_auth

# Tenant-scoped pgcrypto key for encrypted drafts and credentials. Generate a
# separate 64-character hex value with: openssl rand -hex 32
ORACLE_ENCRYPTION_MASTER_KEY=CHANGE_ME_generate_32_byte_hex_secret_before_saving_drafts

# ── Stripe ───────────────────────────────────────────────────────────────────
# Test-mode keys from https://dashboard.stripe.com/test/apikeys
# Webhook secret from the Stripe CLI: stripe listen --print-secret
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_ID=price_REPLACE_ME
# Optional metered price alongside the flat plan. Blank = flat billing; usage is
# still recorded locally by billing_usage.py regardless.
STRIPE_METERED_PRICE_ID=
STRIPE_METER_EVENT_NAME=oracle_lead_engaged
# The drain that carries recorded usage to Stripe's meter. Runs only when the
# periodic scheduler is on (ORACLE_SCHEDULER_ENABLED=1) and short-circuits when
# STRIPE_METERED_PRICE_ID is blank, so leaving it enabled costs nothing.
ORACLE_USAGE_DRAIN_ENABLED=1
ORACLE_USAGE_DRAIN_INTERVAL_MIN=60
# Outcome attribution: binds recorded outcomes (replies, showings, closings) to
# the decision or approved command that earned them. Deferred rather than
# inline because the reply→decision window is fourteen days.
ORACLE_OUTCOME_ATTRIBUTION_ENABLED=1
ORACLE_OUTCOME_ATTRIBUTION_INTERVAL_MIN=15

# Log level for the application's OWN loggers. uvicorn configures only its own,
# so until server.py called basicConfig every logger.info in this codebase was
# dropped — which is why a WebSocket handler that silently stopped reading was
# invisible in the logs for the life of the process.
ORACLE_LOG_LEVEL=INFO

# Missions: goal-seeking outreach. TWO switches, both off, both required.
#   ORACLE_FEATURE_MISSIONS  — the executor checks this on every tick.
#   ORACLE_MISSIONS_ENABLED  — the scheduler only runs the sweep when this is 1.
# The absence of a provider credential is deliberately NOT a third switch:
# measured on a dev stack with zero provider_credentials rows, TWILIO_ACCOUNT_SID
# in the environment made sms and voice both report ready to send.
ORACLE_FEATURE_MISSIONS=0
ORACLE_MISSIONS_ENABLED=0
ORACLE_MISSION_TICK_INTERVAL_MIN=10
ORACLE_OUTCOME_ATTRIBUTION_BATCH=200
ORACLE_USAGE_DRAIN_BATCH=200

# ── AI inference ─────────────────────────────────────────────────────────────
# Which plane serves the assistant. "azure-foundry" is the default so an unset
# variable can never route prompts to AWS; "bedrock" pins the legacy plane.
# ORACLE_AI_CHAT_PROVIDER=azure-foundry
ORACLE_FOUNDRY_PROJECT_ENDPOINT=
ORACLE_FOUNDRY_AGENT_NAME=neoh-kimi-k2-6
ORACLE_FOUNDRY_MODEL=Kimi-K2.6

# The fallback ladder is Foundry → Bedrock → local llama-server. The Bedrock rung
# is off by default: with no AWS credentials it can only add latency and a
# confusing error before the local model runs. Set to 1 to put it back.
ORACLE_AI_BEDROCK_FALLBACK=0

# ── Frontend / CORS ──────────────────────────────────────────────────────────
# Base URL the backend uses for Stripe success/cancel redirects.
ORACLE_BASE_URL=http://localhost:5173

# WebSocket URL the Vite dev server injects into the React bundle.
VITE_WS_URL=ws://localhost:8000/ws

# Frontend identity. VITE_TENANT_ID MUST match ORACLE_DEMO_TENANT_ID below so the
# DealPipeline (RLS-scoped leads) and the billing gate share one tenant.
VITE_TENANT_ID=11111111-1111-1111-1111-111111111111
VITE_USER_ID=demo-operator

# Dev-only: when 'true', skips the Stripe license gate so a local run without a
# live subscription can reach the dashboard. Ignored in production builds
# (import.meta.env.DEV is statically false). Leave false/unset for any deploy.
VITE_BILLING_BYPASS=false

# ── Tenant config (demo / local dev) ─────────────────────────────────────────
# The tenant_id the harvesters ingest under and the WS endpoint falls back to
# when no JWT tenant is present. Must be a valid UUID in prod (RLS enforces it).
ORACLE_DEMO_TENANT_ID=11111111-1111-1111-1111-111111111111

# ── Local LLM (Agent Mind / Memory Core summarizer) ──────────────────────────
# llama-server running Llama-3.2-1B-Instruct. Not required to boot the server —
# mind_service.py and session_manager.py degrade gracefully when unreachable.
ORACLE_LOCAL_LLM_URL=http://127.0.0.1:8090/v1/chat/completions

# ── Kubernetes (Admin C2 chaos panel — optional) ──────────────────────────────
# Only needed if you use /admin/simulate-surge in a real cluster.
# Leave blank for local dev — the K8s HPA queries fail silently with a
# "no_k8s_credentials" placeholder rather than crashing the surge endpoint.
K8S_API_HOST=https://kubernetes.default.svc
K8S_BEARER_TOKEN=
QWEN_VOICE_DEPLOYMENT=qwen-voice-agent
QWEN_VOICE_NAMESPACE=oracle
QWEN_VOICE_HPA=qwen-voice-agent-hpa

# ── Harvester tuning (optional overrides) ────────────────────────────────────
# Sensible defaults are baked into harvesters/base.py; set these only if you
# need to throttle or speed up the 10-state firehose.
# FIREHOSE_MIN_INTERVAL=1.5
# FIREHOSE_JITTER=0.8
# FIREHOSE_MAX_RETRIES=5
# FIREHOSE_PAGE_SIZE=1000
# FIREHOSE_BATCH_SIZE=500

# ── 3D reconstruction via OnCompute (Ocean Network C2D) ──────────────────────
# The live GPU path after RunPod serverless proved undeployable. Mint the JWT
# at dashboard.oncompute.ai/nodes/tokens for the target node. Free tier is
# CPU-only (selftest-grade); real reconstructions need the paid GPU env,
# which requires escrow funding on the consumer account.
# RECONSTRUCTION_PROVIDER=oncompute
# ONCOMPUTE_NODE_URL=
# ONCOMPUTE_AUTH_TOKEN=
# RECON_ONCOMPUTE_TIMEOUT=3600
# ONCOMPUTE_IMAGE=ghcr.io/ydngemini/neoh-recon-runpod:latest
# Operator-key mode (when dashboard token minting is unavailable):
# ONCOMPUTE_PRIVATE_KEY_FILE=/home/ydn/.oncompute/operator.key

# ── ElevenLabs TTS (live-call voice, TEST NUMBERS ONLY) ───────────────────────
# All three must be set for a call to hear a synthesized voice; each defaults
# closed. The free tier carries no commercial licence, so this must not reach a
# customer call — the allowlist is the control, not a convention.
ELEVENLABS_API_KEY=
ORACLE_ELEVENLABS_TTS_ENABLED=0
ORACLE_TTS_TEST_NUMBERS=            # comma-separated E.164; empty = nobody
ORACLE_ELEVENLABS_CHAR_BUDGET=8000  # of a 10,000/month free allowance
ORACLE_ELEVENLABS_VOICE_ID=         # premade voice id; free tier refuses library voices

# How long a migration will WAIT for a table lock before giving up. Default 5s.
#
# CREATE INDEX and other DDL need a lock the running app is using, and Postgres
# queues lock requests FIFO — so a migration waiting behind one long transaction
# also blocks every write that arrives after it, turning a deploy into a write
# outage on that table. Failing fast changes nothing and lets the operator retry.
#
# Raise it for a maintenance window where waiting is the point. If a migration
# times out building indexes, run `python run_migrations.py --prebuild-indexes`
# first: that builds them CONCURRENTLY, without the blocking lock, so the
# migration itself finds them already there and does no work.
ORACLE_MIGRATION_LOCK_TIMEOUT=5s

# Which model ElevenLabs uses when ORACLE_VIDEO_PROVIDER=elevenlabs. ElevenLabs
# aggregates other labs' video models rather than training its own, so this
# reaches Veo 3.1 through the same key used for text-to-speech — no GCP project,
# billing account or ADC, which is the wall the native Veo provider sits behind.
# Versioned in this field, so a newer model is a config change, not a code one.
ORACLE_ELEVENLABS_VIDEO_MODEL=veo-3.1-fast-generate-001

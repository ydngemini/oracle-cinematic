# Oracle frontend configuration. Copy to .env and override per environment.
# For production, use https:// and wss:// against your deployed backend.

# REST API base (no trailing slash). Defaults to http://localhost:8000 if unset.
VITE_API_BASE=http://localhost:8000

# WebSocket endpoint for the live bus. Use wss:// in production.
VITE_WS_URL=ws://localhost:8000/ws

# Optional: pre-fill identity. Normally resolved from login — leave unset in prod.
# VITE_USER_ID=
# VITE_TENANT_ID=

# Dev only: bypass the login gate. Ignored in production builds (import.meta.env.DEV).
# VITE_AUTH_BYPASS=1

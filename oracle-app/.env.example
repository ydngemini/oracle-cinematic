# Oracle frontend configuration. Copy to .env and override per environment.
# For production, use https:// and wss:// against your deployed backend.

# REST API base (no trailing slash). Defaults to http://localhost:8000 if unset.
VITE_API_BASE=http://localhost:8000

# WebSocket endpoint for the live bus. Use wss:// in production.
VITE_WS_URL=ws://localhost:8000/ws

# Feature-gated production surfaces. Keep these aligned with backend flags.
VITE_LOCAL_MODELS_ENABLED=false
VITE_MUNICIPAL_HARVESTS_ENABLED=false

# Google Maps browser-public configuration. Restrict the key by HTTP referrer
# and API; a VITE_ value is bundled into the SPA and is never a secret.
# The key needs BOTH the Maps JavaScript API and the Map Tiles API enabled,
# with billing active — otherwise the photoreal 3D tour degrades to a fallback.
# VITE_GOOGLE_MAPS_KEY=
# VITE_GOOGLE_MAP_ID=
# Maps JS channel serving the maps3d library (Map3DElement). Defaults to alpha;
# set to beta/weekly if Google moves the library between channels.
# VITE_GOOGLE_MAPS_VERSION=alpha

# Optional: pre-fill identity. Normally resolved from login — leave unset in prod.
# VITE_USER_ID=
# VITE_TENANT_ID=

# Dev only: bypass the login gate. Ignored in production builds (import.meta.env.DEV).
# VITE_AUTH_BYPASS=1

# Which WebGL engine draws a walkable tour.
#   playcanvas (default) — .glb meshes, orbit mode, multi-floor navigation
#   gsplat               — the original raw-WebGL viewer; the fallback if a
#                          device regresses on PlayCanvas
# Splats are `.splat` only in both. PLY is training output and is refused at the
# loader; reconstruction_worker converts before anything is served.
VITE_TOUR_ENGINE=playcanvas

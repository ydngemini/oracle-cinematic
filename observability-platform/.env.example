# AWS Observability dashboard config. Leave these blank for same-origin access
# through the Vite dev proxy or production ALB. Use https:// / wss:// only when
# the API lives on a different origin.

# WebSocket base for the live AWS stream. Authentication uses the oracle.jwt
# WebSocket subprotocol; credentials never appear in the URL.
VITE_WS_URL=

# REST base for POST /auth/login (mints the platform_admin/broker_owner JWT).
VITE_API_BASE=

# ---------------------------------------------------------------------------
# Backend requirements for the dashboard to work end-to-end:
#   * AWS_OBSERVABILITY_ENABLED=1   → starts the 15s metrics broadcaster.
#   * ORACLE_CORS_ORIGINS must include this app's origin only when VITE_API_BASE
#     points to a different origin; same-origin proxy/ALB access needs no CORS.
#   * The signed-in account must be role platform_admin or broker_owner.
# ---------------------------------------------------------------------------

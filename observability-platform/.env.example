# AWS Observability dashboard config. Copy to .env (or export as shell vars —
# vite.config.js reads process.env). Use https:// / wss:// in production.

# WebSocket base for the live AWS stream. The app appends /api/aws/ws?token=<jwt>.
VITE_WS_URL=ws://localhost:8000

# REST base for POST /auth/login (mints the platform_admin/broker_owner JWT).
VITE_API_BASE=http://localhost:8000

# Optional: a pre-minted platform_admin JWT to bypass the login screen entirely
# (headless kiosk / CI). Leave unset for normal operator sign-in.
# VITE_AWS_WS_TOKEN=

# ---------------------------------------------------------------------------
# Backend requirements for the dashboard to work end-to-end:
#   * AWS_OBSERVABILITY_ENABLED=1   → starts the 15s metrics broadcaster.
#   * ORACLE_CORS_ORIGINS must include this app's origin (dev default now
#     includes http://localhost:5174) so /auth/login succeeds cross-origin.
#   * The signed-in account must be role platform_admin or broker_owner.
# ---------------------------------------------------------------------------

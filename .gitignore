node_modules/
dist/
dist-ssr/
.next/
out/
*.tsbuildinfo
__pycache__/
*.pyc
.env
.env*.local
# Timestamped .env backups (.env.bak-1785952705) hold the same live keys as
# .env itself — without this they are untracked-but-stageable and a routine
# `git add -A` commits real credentials.
.env.bak*
.env.backup*
*.local
.DS_Store
*.log
*.db
venv/
.local-runtime/
oracle-cinematic/

# Stale root-level artifacts (24MB PostScript files accidentally committed)
/boto3
/json

# Local agent, browser-test, and release-package artifacts
/.artifacts/
/.sypher/
/.test-tmp/
/scripts/.sypher/
/neoh-pillar*-release.bundle

# Claude subagent worktrees (scratch)
.claude/worktrees/

# session scratch / diagnostic dumps
_diag*.txt

# Terraform — never commit state (holds secret ARNs/ids) or filled-in tfvars
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example
infra/terraform/.terraform.lock.hcl
infra/terraform/*.tfplan
infra/terraform/tfplan
crash.log

# Production env (real secrets) — only the .example template is tracked
.env.prod

# Generated Gaussian splats — keep the dir (so the bind-mount target exists),
# ignore the heavy .splat/.json artifacts written into it at runtime.
backend/.splatdata/*
!backend/.splatdata/.gitkeep

# Root-owned Terraform leftovers from a pre-2026-08-27 `sudo terraform` run.
# Moved aside (not deletable without sudo) when the backend was re-pointed to
# account 151105438863. Safe to `sudo rm -rf` once you are satisfied the new
# state is good — the old state's only reachable copy is in ~/aws-state-rescue.
infra/terraform/.terraform-root-owned-old/
infra/terraform/.terraform.lock.hcl.root-owned-old
infra/.tf-root-owned-*/
